# ==============================================================
# Legal Chatbot API — Environment Variables
# Copy this file to .env and fill in your values
# ==============================================================

# ── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/legal_chatbot

# ── JWT ───────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-a-very-long-random-secret-string-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── RAG / LLM ─────────────────────────────────────────────────
# RAG_BACKEND: gemini | openai | openrouter | huggingface | placeholder
RAG_BACKEND=gemini
RAG_MODEL=gemini-2.5-flash
RAG_MAX_TOKENS=2048
RAG_TEMPERATURE=0.1

GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=sk-your-openai-key-here
OPENROUTER_API_KEY=sk-or-your-openrouter-key-here

# ── App ───────────────────────────────────────────────────────
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
RATE_LIMIT_PER_MINUTE=30

# ── Redis (optional) ─────────────────────────────────────────
REDIS_URL=redis://localhost:6380/0

# ── Upload / Ingestion ────────────────────────────────────────
# Optional Windows overrides. Leave empty to use the current Python / PATH.
INGEST_PYTHON_EXE=
POPPLER_PATH=
