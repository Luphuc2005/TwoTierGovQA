# =============================================================
# AI-Powered Legal Chatbot — Web App .env.example
# =============================================================
# Copy: cp .env.example .env
# Xem hướng dẫn chi tiết hơn tại root .env.example
# =============================================================

# ── Database ──────────────────────────────────────────────────
# Chạy thủ công (local PostgreSQL trên port 5433):
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/legal_chatbot
# Chạy bằng Docker Compose (dùng dòng này thay thế):
# DATABASE_URL=postgresql://postgres:postgres@postgres:5432/legal_chatbot

# ── JWT ───────────────────────────────────────────────────────
# Tạo secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-very-long-random-secret-string-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── RAG Backend ───────────────────────────────────────────────
# Chọn: gemini | openai | openrouter | huggingface | placeholder
RAG_BACKEND=gemini
# Dùng "auto" để tự chọn model theo loại backend
RAG_MODEL=auto
RAG_MAX_TOKENS=2048
RAG_TEMPERATURE=0.1

# ── API Keys (chỉ cần key của backend bạn chọn ở RAG_BACKEND) ─
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=sk-your-openai-key-here
OPENROUTER_API_KEY=sk-or-your-openrouter-key-here

# ── Redis (tuỳ chọn — dùng cho rate limiting) ─────────────────
REDIS_URL=redis://localhost:6380/0

# ── App ───────────────────────────────────────────────────────
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
RATE_LIMIT_PER_MINUTE=30

# ── Ingestion Pipeline ────────────────────────────────────────
# Python của môi trường conda/venv có cài paddleocr, torch, etc.
# Windows: C:\Users\<user>\anaconda3\envs\ChatBot\python.exe
# Linux:   /home/<user>/miniconda3/envs/ChatBot/bin/python
INGEST_PYTHON_EXE=C:\Users\ADMIN\anaconda3\envs\ChatBot\python.exe
