# =============================================================
# Legal Chatbot RAG — Root .env.example
# =============================================================
# Hướng dẫn: Copy file này sang .env rồi điền các giá trị thực.
#   cp .env.example .env
#
# File .env KHÔNG được commit lên Git (đã có trong .gitignore).
# File này (.env.example) thì an toàn để commit — không có key thật.
# =============================================================

# ─────────────────────────────────────────────────────────────
# 1. LLM API KEYS
# ─────────────────────────────────────────────────────────────
# Chọn 1 trong 3 dịch vụ dưới đây. Chỉ cần điền key của dịch vụ bạn dùng.

# [Khuyến nghị] Google Gemini (miễn phí tier rộng, nhanh)
# Lấy key tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# [Tuỳ chọn] OpenAI GPT
# Lấy key tại: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here

# [Tuỳ chọn] OpenRouter (truy cập nhiều model qua 1 key)
# Lấy key tại: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-your-openrouter-key-here

# ─────────────────────────────────────────────────────────────
# 2. RAG PIPELINE SETTINGS
# ─────────────────────────────────────────────────────────────
# RAG_BACKEND: gemini | openai | openrouter | huggingface | placeholder
#   - gemini / openai / openrouter: dùng API (cần key ở trên)
#   - huggingface: chạy model local trên máy (cần GPU/CPU đủ mạnh)
#   - placeholder: mode test, không cần model, trả lời giả
RAG_BACKEND=gemini

# Tên model. Dùng "auto" để hệ thống tự chọn theo VRAM:
#   gemini   → gemini-2.5-flash
#   openai   → gpt-4o-mini
#   huggingface → tự chọn Qwen3 theo VRAM (0.6B / 1.7B / 4B)
RAG_MODEL=auto

RAG_MAX_TOKENS=2048
RAG_TEMPERATURE=0.1

# ─────────────────────────────────────────────────────────────
# 3. DATABASE (PostgreSQL)
# ─────────────────────────────────────────────────────────────
# Nếu chạy bằng Docker: dùng dòng Docker bên dưới
# Nếu chạy thủ công:    dùng dòng localhost bên dưới
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/legal_chatbot
# DATABASE_URL=postgresql://postgres:postgres@postgres:5432/legal_chatbot  # Docker

# ─────────────────────────────────────────────────────────────
# 4. JWT AUTHENTICATION
# ─────────────────────────────────────────────────────────────
# Tạo secret key ngẫu nhiên: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-very-long-random-secret-string-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─────────────────────────────────────────────────────────────
# 5. REDIS (Rate limiting — tuỳ chọn)
# ─────────────────────────────────────────────────────────────
# Nếu không có Redis, rate limiting sẽ bị tắt hoặc in warning.
REDIS_URL=redis://localhost:6380/0

# ─────────────────────────────────────────────────────────────
# 6. OCR & DOCUMENT PROCESSING
# ─────────────────────────────────────────────────────────────
# Đường dẫn tới Poppler (cần cho pdf2image khi OCR file quét)
# Windows: D:\Release-25.12.0-0\poppler-25.12.0\Library\bin
# Linux/Mac: thường có sẵn sau apt install poppler-utils
POPPLER_PATH=D:\Release-25.12.0-0\poppler-25.12.0\Library\bin

# Python interpreter của môi trường ChatBot (dùng cho ingestion subprocess)
# Windows Conda: C:\Users\<user>\anaconda3\envs\ChatBot\python.exe
# Linux: /home/<user>/miniconda3/envs/ChatBot/bin/python
INGEST_PYTHON_EXE=C:\Users\ADMIN\anaconda3\envs\ChatBot\python.exe

# ─────────────────────────────────────────────────────────────
# 7. APPLICATION
# ─────────────────────────────────────────────────────────────
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
RATE_LIMIT_PER_MINUTE=30
