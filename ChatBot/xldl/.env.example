# =============================================================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# =============================================================================
# GUIDELINES:
# 1. Rename this file to ".env" for deployment.
# 2. In production, prefer using Secret Managers or Environment Injection.
# 3. Ensure all paths are absolute or relative to the application root.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. LLM SERVICE (EXTERNAL APIS)
# -----------------------------------------------------------------------------
# [Google Gemini] - Recommended for high throughput
GEMINI_API_KEY=
GOOGLE_API_KEY=

# [OpenAI] - Fallback or specialized tasks
OPENAI_API_KEY=

# Model Selection
# Production recommendation: gemini-1.5-flash-latest (Balance of speed/cost)
LLM_MODEL=gemini-1.5-flash-latest
# Request timeout in seconds
LLM_TIMEOUT=60

# -----------------------------------------------------------------------------
# 2. OCR & DOCUMENT PROCESSING ENGINE
# -----------------------------------------------------------------------------
# Paths to binaries. In Docker/Linux, these are typically in /usr/bin
# Leave empty if added to system PATH.

# Tesseract OCR Binary Path
# Linux: /usr/bin/tesseract
# Windows Example: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_PATH=/usr/bin/tesseract

# Poppler Utils Path (pdf2image)
# Linux: /usr/bin
# Windows Example: D:\apps\Poppler\bin
POPPLER_PATH=/usr/bin

# Processing Quality
# Production: 300-400 DPI recommended for balance.
OCR_DPI=300

# -----------------------------------------------------------------------------
# 3. EMBEDDING & VECTOR SEARCH
# -----------------------------------------------------------------------------
# Model: phobert (Vietnamese), bge-m3 (Multilingual)
EMBEDDING_MODEL=phobert

# Vector Database Backend
# Options: faiss (local file), milvus (server), qdrant (server)
VECTOR_DB=faiss

# [Milvus/Qdrant Configuration] - Required if VECTOR_DB is not faiss
# VECTOR_DB_HOST=localhost
# VECTOR_DB_PORT=19530
# VECTOR_DB_COLLECTION=legal_docs

# -----------------------------------------------------------------------------
# 4. DATA PERSISTENCE & STORAGE
# -----------------------------------------------------------------------------
# Use absolute paths for mounted volumes in production (e.g., /app/data/...)

# Intermediate Processing Artifacts
FILE_CHUNKS=./data/intermediate/chunks.json
EMBEDDINGS_FILE=./data/intermediate/embeddings.npy
METADATA_FILE=./data/intermediate/metadata.json

# Vector Store Persistence (for FAISS/Pickle)
VECTOR_STORE=./data/storage/vector_store.pkl

# Final Output Directory
OUTPUT_DIR=./data/output

# -----------------------------------------------------------------------------
# 5. SYSTEM & LOGGING
# -----------------------------------------------------------------------------
# Logging Level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# Enable detailed performance metrics
ENABLE_METRICS=true
# Number of worker threads for parallel processing
MAX_WORKERS=4
